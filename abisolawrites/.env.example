# --- Server ---
# Port the Express server listens on. Railway injects PORT automatically.
PORT=3000
# Public base URL of this deployment, used for checkout return URLs,
# sitemap.xml, and Open Graph URLs.
# Example: https://abisolawrites.com
SITE_URL=https://abisolawrites.com

# --- Billing (Stripe) ---
# Checkout is wired ONLY through these env vars. Until STRIPE_SECRET_KEY is
# set, every purchase / booking button lands on an honest
# "checkout is being reconnected during our move" notice — the site never
# shows a fake success state.
# Stripe Dashboard -> Developers -> API keys (use the account that should
# receive Abisola Writes payouts).
#STRIPE_SECRET_KEY=sk_live_...
# Optional: enables the /webhooks/stripe endpoint to verify signatures.
# Required before relying on webhook-based entitlement grants.
#STRIPE_WEBHOOK_SECRET=<redacted>

# --- Accounts / entitlements store ---
# Production: Postgres. In Railway, add a PostgreSQL database to this
# service and reference its DATABASE_URL here. Without it the server uses a
# local JSON file store (DATA_FILE) — fine for local dev, but Railway's
# filesystem is ephemeral, so lifetime entitlements need Postgres.
#DATABASE_URL=postgres://...
#DATA_FILE=./data/store.json
# Optional: enables POST /api/admin/grant and /api/admin/revoke
# (Authorization: Bearer <token>) for manual entitlement grants.
#ADMIN_TOKEN=

# --- Sign-in ---
# Email sign-in is live (accounts are created on the site; passwords are
# scrypt-hashed server-side). Google sign-in is NOT connected: /auth/google
# redirects to /signin until a Google Cloud OAuth client exists.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
