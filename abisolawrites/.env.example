# --- Server ---
# Port the Express server listens on. Railway injects PORT automatically.
PORT=3000
# Public base URL of this deployment, used for checkout return URLs,
# sitemap.xml, and Open Graph URLs.
# Example: https://abisolawrites.com
SITE_URL=https://abisolawrites.com

# --- Billing (Stripe) ---
# Checkout is wired ONLY through these env vars. Until STRIPE_SECRET_KEY is
# set, every purchase / booking button lands on an honest
# "checkout is being reconnected during our move" notice — the site never
# shows a fake success state.
# Stripe Dashboard -> Developers -> API keys (use the account that should
# receive Abisola Writes payouts).
#STRIPE_SECRET_KEY=sk_live_...
# Optional: enables the /webhooks/stripe endpoint to verify signatures.
# Required before relying on webhook-based entitlement grants.
#STRIPE_WEBHOOK_SECRET=<redacted>

# --- Sign-in (Google) — SEAM, not yet connected ---
# The live Emergent site used Google sign-in only. The rebuild keeps a
# /auth/google placeholder route; no sign-in happens until a Google Cloud
# OAuth client exists and these are set in Railway.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
