# CryptoBagTracker environment variables.
# Copy to .env for local development. On Railway, set these in the service's
# Variables tab (DATABASE_URL is provided automatically by the Postgres plugin).

# REQUIRED — Postgres connection string.
# Railway: add the Postgres plugin to the project and this is set automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/cryptobagtracker

# OPTIONAL — HTTP port. Railway injects PORT automatically; defaults to 3000.
PORT=3000

# OPTIONAL — override where the server finds the built client bundle and the
# SQL migrations. Defaults work for the Dockerfile layout (./client/dist,
# ./drizzle relative to the working directory).
# CLIENT_DIR=/app/client/dist
# MIGRATIONS_DIR=/app/drizzle

# --- Stripe billing (all server-side; never exposed to the client) ---
# The app boots and runs fine without these. Billing actions return a clear
# "Billing is not configured yet." error until they are set.

# Stripe API secret key (dashboard → Developers → API keys).
# STRIPE_SECRET_KEY=<redacted>

# Webhook signing secret for POST /webhooks/stripe
# (dashboard → Developers → Webhooks → the endpoint's signing secret).
# STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID for the $8.88/month Premium plan
# (dashboard → Product catalog → the product → price ID).
# STRIPE_PRICE_ID=price_...

# Public base URL of this deployment, used for Stripe checkout
# success/cancel URLs and the billing-portal return URL.
# Railway: set to your service domain, e.g. https://cryptobagtracker.up.railway.app
# APP_BASE_URL=http://localhost:3000

# --- Price alerts (all server-side; never exposed to the client) ---
# The app boots and runs fine without these. The scheduler still checks
# prices every PRICE_CHECK_INTERVAL_MS and records triggers in
# alert_history; alerts that can't be delivered are logged as undelivered.

# Telegram bot token for alert delivery
# (Telegram → message @BotFather → /newbot → follow the prompts → copy the token).
# Each user also saves their own Telegram chat ID in the app's Alerts settings
# (they find it by messaging @userinfobot).
# TELEGRAM_BOT_TOKEN=<redacted>

# OPTIONAL — how often the price-alert scheduler runs. Default 5 minutes.
# PRICE_CHECK_INTERVAL_MS=300000

# OPTIONAL — minimum time between repeat fires of the same alert while the
# price stays crossed. Default 24 hours (86400000 ms).
# ALERT_COOLDOWN_MS=86400000

# OPTIONAL — generic outbound webhook fired on every alert trigger, e.g. a
# Zapier "Catch Hook" URL. Payload:
# {userId, alertId, asset, direction, targetPrice, currentPrice, triggeredAt}.
# Fire-and-forget; never blocks Telegram delivery or the scheduler.
# ALERT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
