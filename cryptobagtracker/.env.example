# CryptoBagTracker environment variables.
# Copy to .env for local development. On Railway, set these in the service's
# Variables tab (DATABASE_URL is provided automatically by the Postgres plugin).

# REQUIRED — Postgres connection string.
# Railway: add the Postgres plugin to the project and this is set automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/cryptobagtracker

# OPTIONAL — HTTP port. Railway injects PORT automatically; defaults to 3000.
PORT=3000

# OPTIONAL — override where the server finds the built client bundle and the
# SQL migrations. Defaults work for the Dockerfile layout (./client/dist,
# ./drizzle relative to the working directory).
# CLIENT_DIR=/app/client/dist
# MIGRATIONS_DIR=/app/drizzle
