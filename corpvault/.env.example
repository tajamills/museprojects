# --- Required ---
# Postgres connection string. On Railway, add the Postgres plugin to the
# service and this is provided automatically as a service variable.
DATABASE_URL=postgresql://user:password@host:5432/corpvault

# --- Optional ---
# Directory where uploaded documents are stored on local disk.
# Default: ./data (relative to the working directory the server starts in).
# Mount a Railway volume at this path for persistence across deploys.
DATA_DIR=./data

# Port the server listens on. Railway injects PORT automatically.
PORT=3000

# --- Billing (Stripe) ---
# All optional: the app boots and runs without them, but checkout/portal
# actions fail with "Billing is not configured yet." until set.
# Stripe API secret key (sk_live_... / sk_test_...).
STRIPE_SECRET_KEY=
# Price ID for the $199.88/year kovala plan (charges immediately, no trial).
STRIPE_PRICE_ID=
# Webhook signing secret for POST /webhooks/stripe. The code reads
# STRIPE_WEBHOOK_SECRET first, then falls back to STRIPE_WEBHOOK.
STRIPE_WEBHOOK_SECRET=
# Public base URL for Stripe checkout/portal redirects, e.g. https://kovala.io.
# Falls back to the request origin when unset.
APP_BASE_URL=
