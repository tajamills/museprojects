{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "express": "4.21.2",
    "pg": "8.13.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "stripe": "^23.0.0",
    "zod": "4.4.3"
  },
  "description": "kovala — business entity manager, document vault, compliance reminders, meeting minutes. Railway-deployable port of the Hatch TS-space.",
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.24.2",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "kovala",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "node client/build.mjs",
    "build:server": "tsc -p server/tsconfig.json && cp -r server/migrations dist/server/migrations",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p client/tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}
