# --- Required ---
# Postgres connection string. On Railway: add the Postgres plugin to the
# service and DATABASE_URL is provided automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_app

# --- Server ---
# Port the Express server listens on. Railway injects PORT automatically.
PORT=3000
# Public base URL of this deployment, used in OAuth callback URLs and docs.
# Example: https://zepostia.up.railway.app
APP_BASE_URL=http://localhost:3000
# Directory where uploaded media is stored (served at /media). Use an absolute
# path in production; mount a persistent volume here if uploads must survive
# redeploys.
MEDIA_DIR=./media

# --- Scheduler ---
# How often (ms) the in-process worker loop checks for due scheduled posts
# and bump comments. Must run as a single replica (see DEPLOY.md).
SCHEDULER_INTERVAL_MS=30000

# --- Owner Meta app (REQUIRED for Facebook + Instagram) ---
# zepostia uses ONE Meta app owned by the site owner. Customers never create
# a Meta app and never enter an App ID or secret -- they just click Connect
# on the Accounts page and OAuth in with Facebook. Set these once in Railway.
# Never commit real values to git.
# The Meta App ID (developers.facebook.com -> your app -> App settings -> Basic).
FACEBOOK_APP_ID=
# The Meta App Secret (same page -> click Show). Used for both Facebook and
# Instagram (Instagram shares the Meta app; no INSTAGRAM_CLIENT_SECRET needed).
FACEBOOK_CLIENT_SECRET=<redacted>

# --- Token encryption (REQUIRED) ---
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# Encrypts OAuth tokens at rest. If it ever changes, users re-connect.
# TOKEN_ENCRYPTION_KEY=<64 hex chars>

# --- Optional OAuth overrides ---
# Callback URLs. Defaults to {APP_BASE_URL}/oauth/facebook/callback and
# {APP_BASE_URL}/oauth/instagram/callback -- register the exact URLs in the
# Meta app under Facebook Login for Business -> Settings -> Valid OAuth
# Redirect URIs.
# FACEBOOK_REDIRECT_URI=https://zepostia.com/oauth/facebook/callback
# INSTAGRAM_REDIRECT_URI=https://zepostia.com/oauth/instagram/callback

# --- Other platform secrets (per-user, entered in Settings UI) ---
# TikTok / YouTube / X still use per-user credentials entered in the app's
# Settings page (encrypted before storage). No env vars needed for them.
#TIKTOK_CLIENT_SECRET=
#YOUTUBE_CLIENT_SECRET=
#X_CLIENT_SECRET=
# --- Admin access ---
# Comma-separated emails that automatically get the 'admin' role on signup
# and on login (case-insensitive). No admin UI yet; the role is exposed in
# the auth and workspace responses for future use.
ADMIN_EMAILS=you@example.com

# DEMO_MODE: set to "true" to show demo/test UI (demo ribbon, demo workspace
# button, "Run demo OAuth" labels). Default (unset or anything else): production
# behavior — all demo chrome is hidden from users.
# DEMO_MODE=false
