# --- Required ---
# Postgres connection string. On Railway: add the Postgres plugin to the
# service and DATABASE_URL is provided automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_app

# --- Server ---
# Port the Express server listens on. Railway injects PORT automatically.
PORT=3000
# Public base URL of this deployment, used in OAuth callback URLs and docs.
# Example: https://zepostia.up.railway.app
APP_BASE_URL=http://localhost:3000
# Directory where uploaded media is stored (served at /media). Use an absolute
# path in production; mount a persistent volume here if uploads must survive
# redeploys.
MEDIA_DIR=./media

# --- Scheduler ---
# How often (ms) the in-process worker loop checks for due scheduled posts
# and bump comments. Must run as a single replica (see DEPLOY.md).
SCHEDULER_INTERVAL_MS=30000

# --- Owner Meta app (REQUIRED for Facebook + Instagram) ---
# zepostia uses ONE Meta app owned by the site owner. Customers never create
# a Meta app and never enter an App ID or secret -- they just click Connect
# on the Accounts page and OAuth in with Facebook. Set these once in Railway.
# Never commit real values to git.
# The Meta App ID (developers.facebook.com -> your app -> App settings -> Basic).
FACEBOOK_APP_ID=
# The Meta App Secret (same page -> click Show). Used for both Facebook and
# Instagram (Instagram shares the Meta app; no INSTAGRAM_CLIENT_SECRET needed).
FACEBOOK_CLIENT_SECRET=<redacted>

# --- Token encryption (REQUIRED) ---
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# Encrypts OAuth tokens at rest. If it ever changes, users re-connect.
# TOKEN_ENCRYPTION_KEY=<64 hex chars>

# --- Optional OAuth overrides ---
# Callback URLs. Defaults to {APP_BASE_URL}/oauth/facebook/callback and
# {APP_BASE_URL}/oauth/instagram/callback -- register the exact URLs in the
# Meta app under Facebook Login for Business -> Settings -> Valid OAuth
# Redirect URIs.
# FACEBOOK_REDIRECT_URI=https://zepostia.com/oauth/facebook/callback
# INSTAGRAM_REDIRECT_URI=https://zepostia.com/oauth/instagram/callback
# YOUTUBE_REDIRECT_URI=https://zepostia.com/oauth/youtube/callback

# --- Owner YouTube app (REQUIRED for YouTube) ---
# zepostia uses ONE Google Cloud OAuth client owned by the site owner.
# Customers never create a Google Cloud project and never enter a client ID
# or secret -- they just click Connect on the Accounts page and OAuth in
# with Google. Set these once in Railway. Never commit real values to git.
# Google Cloud Console -> your project -> APIs & Services -> Credentials ->
# OAuth 2.0 Client ID (Web application). Add the redirect URI above under
# "Authorized redirect URIs". Also enable the YouTube Data API v3.
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=

# --- Owner TikTok app (REQUIRED for TikTok) ---
# zepostia uses ONE TikTok for Developers app owned by the site owner
# (developers.tiktok.com -> your app -> Login Kit + Content Posting API).
# Customers never create a TikTok app — they just click Connect on the
# Accounts page and OAuth in. Set these once in Railway. Never commit real
# values to git.
# Register this Redirect URI in the TikTok app:
#   https://zepostia.com/oauth/tiktok/callback
# (override with TIKTOK_REDIRECT_URI if needed).
# Requested scopes: user.info.basic, video.upload, video.publish
#TIKTOK_CLIENT_KEY=
#TIKTOK_CLIENT_SECRET=<redacted>
#TIKTOK_REDIRECT_URI=https://zepostia.com/oauth/tiktok/callback
#
# IMPORTANT — TikTok app audit: unaudited TikTok apps can only direct-post to
# SELF_ONLY (private). PUBLIC_TO_EVERYONE requires passing TikTok's app
# audit. zepostia defaults to SELF_ONLY so posting works immediately.
#

# --- Owner X app (REQUIRED for X) ---
# zepostia uses ONE X app owned by the site owner (developer.x.com -> your
# app -> OAuth 2.0 settings). Customers never create an X app — they just
# click Connect on the Accounts page and OAuth in. Set these once in Railway.
# Never commit real values to git.
# The X Client ID (OAuth 2.0 Client ID in the developer portal).
X_CLIENT_ID=
# The X Client Secret (same page). Encrypted per-user tokens use it at
# OAuth time; it is never exposed to customers.
#X_CLIENT_SECRET=
#
# IMPORTANT — X API PRICING: X moved new developers to pay-per-use pricing
# (Feb 2026); there is no free tier for new apps. Every tweet posted bills
# the OWNER's X developer account credits (post create ≈ $0.015 each;
# posts containing a URL cost more, ≈ $0.20 as of Apr 2026). Fund credits
# in the X Developer Console before enabling real X posting, and factor
# this per-post cost into pricing.
#
# Optional callback override (default: {APP_BASE_URL}/oauth/x/callback) —
# register the exact URL in the X app's OAuth 2.0 Callback URI list.
#X_REDIRECT_URI=https://zepostia.com/oauth/x/callback
# --- Billing (Stripe) ---
#STRIPE_SECRET_KEY=
#STRIPE_PRICE_ID=
#STRIPE_WEBHOOK_SECRET=
#
# X (Twitter) posting add-on tiers — OPTIONAL. One JSON array; one entry
# per tier of the single Stripe product "X Posting Add-on" (one recurring
# monthly price per tier). Leave unset and the add-on is not offered
# anywhere in the app. See OWNER_SETUP.md §5.
#STRIPE_X_TIERS=[{"priceId":"price_...","name":"Starter","postsPerMonth":100,"linkPostsPerMonth":25}]
#
# Black Friday launch (waitlist playbook) — OPTIONAL, both of them.
# STRIPE_TRIPWIRE_PRICE_ID: the one-time $8.88 price on the Stripe
# product "90 Plug-and-Post Captions". Set it and the confirmation
# page (/black-friday/youre-in) offers the pack; leave it unset and
# the pack is not mentioned anywhere.
#STRIPE_TRIPWIRE_PRICE_ID=
# STRIPE_BF_COUPON_ID: the Black Friday deal coupon ($10.00 off,
# duration "once" — first month $9.88, then $19.88). It is applied
# ONLY by the separate BF checkout action, ONLY inside the cart
# window Fri Nov 27 – Mon Nov 30, 2026 (America/New_York). The
# regular checkout never sees it.
#STRIPE_BF_COUPON_ID=

# --- Admin access ---
# Comma-separated emails that automatically get the 'admin' role on signup
# and on login (case-insensitive). No admin UI yet; the role is exposed in
# the auth and workspace responses for future use.
ADMIN_EMAILS=you@example.com

# DEMO_MODE: set to "true" to show demo/test UI (demo ribbon, demo workspace
# button, "Run demo OAuth" labels). Default (unset or anything else): production
# behavior — all demo chrome is hidden from users.
# DEMO_MODE=false
